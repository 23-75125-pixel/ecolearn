# Copy this file to .env.e2e.local and replace the placeholders.
# .env.e2e.local is ignored and is loaded automatically by npm run test:e2e.
# These accounts must already exist in the test Supabase project.

E2E_PASSWORD=replace-with-test-account-password

E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_NAME=Test Admin

E2E_TUTOR_EMAIL=tutor@example.com
E2E_TUTOR_NAME=Test Tutor

E2E_STUDENT_EMAIL=student@example.com
E2E_STUDENT_NAME=Test Student

# Optional:
# BASE_URL=http://localhost:3000
# HEADED=1
# EMAIL_CONFIRMATION_REQUIRED=1
# CHROMIUM_BINARY=/usr/bin/chromium
# CHROMEDRIVER_BINARY=/usr/bin/chromedriver
